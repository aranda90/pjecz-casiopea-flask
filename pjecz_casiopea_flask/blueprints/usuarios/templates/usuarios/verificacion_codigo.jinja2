{% extends 'layouts/login.jinja2' %}

{% block title %}{{ title }}{% endblock %}

{% block custom_head %}
    <style>
        /* Casillas del código de verificación, del ancho del recuadro del login */
        .codigo-casilla {
            width: 42px;
            height: 48px;
            padding: 0;
            font-size: 22px;
            text-align: center;
        }
    </style>
{% endblock %}

{% block welcome %}
    <div id="welcome" class="text-center">
        <p><img class="img-fluid" src="https://storage.googleapis.com/pjecz-informatica/static/images/logo-login.png" alt="PJECZ"></p>
        <h4 class="mb-3" id="titulo">{{ title }}</h4>
    </div>
{% endblock %}

{% block content %}
    <div class="my-2 text-light" data-bs-theme="dark">
        <form method="post" action="{{ url_for('usuarios.verificacion_codigo') }}" autocomplete="off" role="form">
            {{ form.hidden_tag() }}
            <input type="hidden" name="{{ form.codigo.name }}" id="codigo" value="">
            <p class="small">Ingrese el código de 6 dígitos enviado a <strong>{{ destino }}</strong>.</p>
            <div class="d-flex justify-content-center gap-2" data-bs-theme="light">
                {% for i in range(6) %}
                    <input type="text" class="form-control codigo-casilla" inputmode="numeric" autocomplete="one-time-code"
                        maxlength="6" aria-label="Dígito {{ i + 1 }} del código">
                {% endfor %}
            </div>
            <button class="w-100 btn btn-lg btn-primary my-2" type="submit" id="btn_validar" disabled>Validar código</button>
        </form>
        <form method="post" action="{{ url_for('usuarios.verificacion_metodo') }}" class="text-center">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="aut_tipo_envio" value="{{ aut_tipo_envio_id }}">
            <button type="submit" class="btn btn-link link-light" id="btn_reenviar" data-segundos="{{ segundos_reenvio }}">Reenviar código</button>
        </form>
        <a class="w-100 btn btn-outline-light" href="{{ url_for('usuarios.verificacion_metodo') }}">Cambiar método de envío</a>
    </div>
{% endblock %}

{% block custom_javascript %}
    <script>
        // Casillas del código: avanza sola, permite pegar el código completo y retroceder
        const LONGITUD_CODIGO = 6;
        const casillas = [...document.querySelectorAll('.codigo-casilla')];
        const codigo = document.getElementById('codigo');
        const btnValidar = document.getElementById('btn_validar');

        const actualizar = () => {
            codigo.value = casillas.map((c) => c.value).join('');
            btnValidar.disabled = codigo.value.length !== LONGITUD_CODIGO;
        };

        casillas.forEach((casilla, i) => {
            casilla.addEventListener('focus', () => casilla.select());
            casilla.addEventListener('input', () => {
                const limpio = casilla.value.replace(/\D/g, '');
                casilla.value = '';
                limpio.slice(0, LONGITUD_CODIGO - i).split('').forEach((d, k) => { casillas[i + k].value = d; });
                actualizar();
                if (limpio) casillas[Math.min(i + limpio.length, LONGITUD_CODIGO - 1)].focus();
            });
            casilla.addEventListener('keydown', (e) => {
                if (e.key !== 'Backspace') return;
                e.preventDefault();
                if (casilla.value) {
                    casilla.value = '';
                } else if (i > 0) {
                    casillas[i - 1].value = '';
                    casillas[i - 1].focus();
                }
                actualizar();
            });
        });
        casillas[0].focus();

        // Cuenta regresiva para reenviar el código
        const btnReenviar = document.getElementById('btn_reenviar');
        let segundos = parseInt(btnReenviar.dataset.segundos, 10) || 0;
        const pintar = () => {
            btnReenviar.disabled = segundos > 0;
            btnReenviar.textContent = segundos > 0 ? `Reenviar código (${segundos}s)` : 'Reenviar código';
        };
        pintar();
        const reloj = setInterval(() => {
            segundos -= 1;
            pintar();
            if (segundos <= 0) clearInterval(reloj);
        }, 1000);
    </script>
{% endblock %}
